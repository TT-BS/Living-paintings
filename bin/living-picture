#!/bin/sh
''':'
# This file is a shell script and a Python program at once; the shell part only picks the Python that runs the rest.
# Finder, the Dock and Shortcuts start commands with a bare PATH, where python3 is Apple's /usr/bin/python3, and
# without the Command Line Tools that stub opens an installer dialog instead of running. So: LIVING_PICTURE_PYTHON,
# python3 on PATH unless it is that stub, the usual Homebrew, conda and python.org places, and the stub last, only
# when the developer tools are installed.
use() { if [ -n "$1" ] && [ -x "$1" ] && [ ! -d "$1" ]; then p="$1"; shift; exec "$p" "$0" "$@"; fi; }
[ -z "${LIVING_PICTURE_PYTHON:-}" ] || use "$(command -v "$LIVING_PICTURE_PYTHON")" "$@"
stub=; [ ! -e /usr/bin/xcode-select ] || stub=/usr/bin/python3  # only a Mac has the stub; elsewhere it is a real Python
py="$(command -v python3)"; { [ -n "$stub" ] && [ "$py" = "$stub" ]; } || use "$py" "$@"
for d in /opt/homebrew/bin /usr/local/bin /opt/miniconda3/bin "$HOME/miniconda3/bin" /opt/anaconda3/bin "$HOME/anaconda3/bin" "$HOME/miniforge3/bin" /opt/homebrew/Caskroom/miniforge/base/bin /Library/Frameworks/Python.framework/Versions/Current/bin; do
  use "$d/python3" "$@"
done
d="$(xcode-select -p 2>/dev/null)" && [ -d "$d" ] && use /usr/bin/python3 "$@"
echo "living-picture: no python3 that can run here. Install Python 3 (brew install python, or python.org) or set LIVING_PICTURE_PYTHON; Apple's /usr/bin/python3 works once the Command Line Tools are installed: xcode-select --install" >&2
exit 2
'''
# living-picture: one command for the tools of the living-picture skill.
#
# SKILL.md is the judgment: an agent reads the picture and decides. This command only runs the tools, so any agent
# (Claude Code, Codex) or a person can call them without knowing where the skill is installed. It resolves its own
# real path, so it works through symlinks such as ~/.local/bin/living-picture. Standard library only.
import argparse
import datetime
import filecmp
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SCRIPTS = os.path.join(ROOT, "scripts")
PICTURE = os.path.join(SCRIPTS, "picture.py")
CAPTURE = os.path.join(SCRIPTS, "capture.mjs")
BRIDGE = os.path.join(SCRIPTS, "codex_bridge.py")
NAME = "living-picture"
HOME = os.path.expanduser("~")
CACHE = os.path.join(HOME, "Library", "Caches", NAME)
DEPS = (("numpy", "numpy"), ("scipy", "scipy"), ("PIL", "Pillow"))
# Apps started from the Dock, Shortcuts or Finder get a bare PATH without Homebrew,
# yet capture still needs node and ffmpeg there.
EXTRA_PATH = ("/opt/homebrew/bin", "/usr/local/bin")
# Share platforms deliver far smaller pictures (the marked downloads seen here are 928-1440 px), while the watermark
# search runs at full resolution: about 3 s and 0.15 GB per megapixel, 100 s and 2.4 GB on a 24 MP photo. So `new`
# searches only pictures up to this longer side; `picture.py dewatermark` still searches any picture by hand.
WATERMARK_MAX_SIDE = 2560
# The photo correction (picture.py rectify) keeps the work at its own detail in the photo, never enlarged, up to this
# longer side (rectify's default) or the job's own --max if that is larger; prepare caps the working copy afterwards.
RECTIFY_MAX = 4096
RECT, RECT_REVIEW = "rectified.png", "rectified-review.jpg"
q = shlex.quote  # paths inside the commands that `new` suggests, so they paste intact


def die(msg, code=2):
    sys.stderr.write("living-picture: %s\n" % msg)
    sys.exit(code)


def child_env():
    env = dict(os.environ)
    parts = [p for p in env.get("PATH", "").split(os.pathsep) if p]
    parts += [d for d in EXTRA_PATH if os.path.isdir(d) and d not in parts]
    env["PATH"] = os.pathsep.join(parts)
    return env


ENV = child_env()


def which(name):
    return shutil.which(name, path=ENV["PATH"])


def probe(cmd, timeout=30):
    """(exit code, stdout, stderr) of a short command; never raises."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=ENV)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return -1, "", str(e)


def exec_(cmd):
    sys.stdout.flush()
    sys.stderr.flush()
    try:
        os.execvpe(cmd[0], cmd, ENV)
    except OSError as e:
        die("cannot run %s: %s" % (cmd[0], e))


def inside(path, parent):
    p, q = os.path.realpath(path), os.path.realpath(parent)
    return p == q or p.startswith(q.rstrip(os.sep) + os.sep)


def sha256(path, n=None):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()[:n] if n else h.hexdigest()


def tilde(p):
    return "~" + p[len(HOME):] if p == HOME or p.startswith(HOME + os.sep) else p


# ---- the Python that runs picture.py ---------------------------------------------------

def _has_deps_here():
    import importlib.util
    return all(importlib.util.find_spec(m) for m, _ in DEPS)


def _has_deps(py):
    code = "import importlib.util as u,sys;sys.exit(0 if all(u.find_spec(m) for m in %r) else 1)" % ([m for m, _ in DEPS],)
    return probe([py, "-c", code])[0] == 0


def python_candidates():
    c = [which("python3"), "/opt/homebrew/bin/python3", "/usr/local/bin/python3",
         "/opt/miniconda3/bin/python3", os.path.join(HOME, "miniconda3/bin/python3"),
         "/opt/anaconda3/bin/python3", os.path.join(HOME, "anaconda3/bin/python3"),
         os.path.join(HOME, "miniforge3/bin/python3"), "/opt/homebrew/Caskroom/miniforge/base/bin/python3",
         "/Library/Frameworks/Python.framework/Versions/Current/bin/python3"]
    out, seen = [], {os.path.realpath(sys.executable)}
    for p in c:
        # on a Mac /usr/bin/python3 is a stub that can pop up the Command Line Tools installer: never probe it
        if not p or (p == "/usr/bin/python3" and sys.platform == "darwin") or os.path.isdir(p) or not os.access(p, os.X_OK):
            continue
        r = os.path.realpath(p)
        if r not in seen:
            seen.add(r)
            out.append(p)
    return out


_PY = []


def tools_python():
    """$LIVING_PICTURE_PYTHON, else this interpreter if it has numpy/scipy/Pillow, else the first one found that does.

    A Mac often has several Pythons (Apple's, python.org, Homebrew, conda) and only one of them has the packages.
    """
    if not _PY:
        env = os.environ.get("LIVING_PICTURE_PYTHON")
        if env:
            _PY.append((env, "LIVING_PICTURE_PYTHON"))
        elif _has_deps_here():
            _PY.append((sys.executable, "the interpreter running this command"))
        else:
            other = next((p for p in python_candidates() if _has_deps(p)), None)
            _PY.append((other, "found: the interpreter running this command lacks the packages") if other
                       else (sys.executable, "the interpreter running this command (packages missing)"))
    return _PY[0]


def find_node():
    return os.environ.get("LIVING_PICTURE_NODE") or which("node")


_BRIDGE = []


def bridge():
    """scripts/codex_bridge.py as a module, or None. It owns finding Codex and asking its version, so doctor and the
    bridge agree."""
    if not _BRIDGE:
        try:
            sys.path.insert(0, SCRIPTS)
            sys.dont_write_bytecode = True  # keep the shared skill folder free of __pycache__
            import codex_bridge
            _BRIDGE.append(codex_bridge)
        except Exception:
            _BRIDGE.append(None)
    return _BRIDGE[0]


def find_codex():
    b = bridge()
    return b.find_codex() if b else which("codex")


def codex_version(codex):
    # never a bare `codex --version`: even that writes under $CODEX_HOME (the bridge gives it a throwaway one)
    b = bridge()
    return b.codex_version(codex) if b else None


OWN = ("capture", "new", "doctor", "paths", "help", "codex")  # this command's own names win over picture.py's


def picture_commands():
    """[(name, help)] read from picture.py's own parser, so new tools (vision, ...) show up by themselves."""
    try:
        with open(PICTURE, encoding="utf-8") as f:
            src = f.read()
    except OSError:
        return []
    out = []
    for m in re.finditer(r"""add_parser\(\s*(['"])([\w-]+)\1\s*(?:,\s*help\s*=\s*(['"])(.*?)\3)?""", src):
        if m.group(2) not in OWN and m.group(2) not in [n for n, _ in out]:
            out.append((m.group(2), m.group(4) or ""))
    return out


def usage():
    pic = picture_commands()
    names = [n for n, _ in pic]
    row = lambda n, h: "  %-9s %s" % (n, h)  # noqa: E731
    lines = ["usage: living-picture <command> [options]        (every command takes --help)", "",
             "Tools of the living-picture skill in %s" % ROOT,
             "The agent judges; these only see, measure, cut and render. Tools print JSON on stdout.", "",
             "Picture tools (scripts/picture.py):"]
    lines += [row(n, h) for n, h in pic]
    if "vision" not in names:
        lines.append(row("vision", "(not in this copy; appears when picture.py has the macOS Vision helper)"))
    lines += ["", "Frames and video (scripts/capture.mjs; Node 22+ and Chrome, Chromium or Edge):",
              row("capture", "render frames, probes or a short video of a bundled page"), "",
              "Jobs and setup:",
              row("new", "start a job folder for a picture: watermark check, photo correction, prepare, look, notes.md "
                         "(refuses inside git or over a job)"),
              row("doctor", "check Python packages, Node, browser, video, Xcode tools, Codex and installs"),
              row("paths", "where the skill's files are (JSON)"),
              row("help", "help CMD is CMD --help"), "",
              "Opt-in Codex bridge (scripts/codex_bridge.py; sends nothing without --consent-upload):",
              row("codex", "codex review FRAME...  an independent review of rendered frames by Codex"),
              row("", "codex plate            how a Codex imagegen plate repair works and what it sends"), "",
              "Environment: LIVING_PICTURE_PYTHON (a python3 with numpy, scipy, Pillow), LIVING_PICTURE_NODE,",
              "CHROME_PATH (browser for capture), LIVING_PICTURE_CODEX (codex binary).",
              "Docs: SKILL.md (how to work), references/invocation.md (install, CLI, batches, Codex)."]
    return "\n".join(lines) + "\n"


# ---- doctor ----------------------------------------------------------------------------

VERSIONS = ("import json, sys\n"
            "v = {'python': '.'.join(map(str, sys.version_info[:3]))}\n"
            "for m, n in (('numpy', 'numpy'), ('scipy', 'scipy'), ('PIL', 'Pillow')):\n"
            "    try:\n"
            "        v[n] = __import__(m).__version__\n"
            "    except Exception:\n"
            "        v[n] = None\n"
            "print(json.dumps(v))\n")


def browser_candidates():
    """The places capture.mjs looks for a browser, read from its findChrome so the two cannot disagree."""
    try:
        with open(CAPTURE, encoding="utf-8") as f:
            src = f.read()
        body = src[src.index("function findChrome"):]
        body = body[:body.index("\n}")]
        found = [p.replace("\\\\", "\\") for p in re.findall(r"""['"]((?:/|[A-Z]:\\\\)[^'"]+)['"]""", body)]
        if found:
            return found
    except (OSError, ValueError):
        pass
    return ["/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
            "/Applications/Chromium.app/Contents/MacOS/Chromium",
            "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"]


def install_state(path):
    """How `path` relates to this folder: this folder, a link to it, a link elsewhere, a separate copy, or nothing."""
    if os.path.islink(path):
        target = os.readlink(path)
        if not os.path.exists(path):
            return "dangling symlink", {"target": target}
        if os.path.realpath(path) == os.path.realpath(ROOT if os.path.isdir(path) else os.path.join(ROOT, "bin", NAME)):
            return "symlink to this folder" if os.path.isdir(path) else "symlink to this command", {"target": target}
        return "symlink elsewhere", {"target": os.path.realpath(path)}
    if os.path.isdir(path):
        if os.path.realpath(path) == ROOT:
            return "this folder", {}
        md = os.path.join(path, "SKILL.md")
        same = os.path.isfile(md) and sha256(md) == sha256(os.path.join(ROOT, "SKILL.md"))
        return "separate copy", {"same_skill_md": same}
    if os.path.exists(path):
        return "a file", {}
    return "missing", {}


def cmd_doctor(argv):
    ap = argparse.ArgumentParser(prog="living-picture doctor",
                                 description="Check what the skill's tools need on this machine and where the skill is "
                                             "installed for Claude Code, Codex and ~/.agents. Exits 1 if something required is missing.")
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--json", action="store_true", help="JSON report (the default when stdout is not a terminal)")
    g.add_argument("--text", action="store_true", help="readable report (the default in a terminal)")
    a = ap.parse_args(argv)
    checks = []

    def add(area, status, detail, fix=None, required=False, **extra):
        c = {"area": area, "status": status, "detail": detail}
        if fix:
            c["fix"] = fix
        if required:
            c["required"] = True
        c.update(extra)
        checks.append(c)

    # picture.py: Python 3.9+ with numpy, scipy, Pillow
    py, why = tools_python()
    code, out, err = probe([py, "-c", VERSIONS])
    try:
        v = json.loads(out)
    except ValueError:
        v = None
    if code != 0 or not v:
        add("python", "missing", "cannot run %s: %s" % (py, err or out),
            "fix LIVING_PICTURE_PYTHON or unset it" if os.environ.get("LIVING_PICTURE_PYTHON")
            else "set LIVING_PICTURE_PYTHON to a python3 with numpy, scipy, Pillow", True)
    else:
        lacking = [n for _, n in DEPS if not v.get(n)]
        if lacking:
            others = [p for p in [sys.executable] + python_candidates()
                      if os.path.realpath(p) != os.path.realpath(py) and _has_deps(p)]
            fix = "%s -m pip install numpy scipy pillow" % py
            if others:
                fix += "  (or use %s: export LIVING_PICTURE_PYTHON=%s)" % (others[0], others[0])
            add("python", "missing", "%s %s lacks %s" % (py, v["python"], ", ".join(lacking)), fix, True)
        elif tuple(int(x) for x in v["python"].split(".")[:2]) < (3, 9):
            add("python", "old", "%s is Python %s; the tools need 3.9+" % (py, v["python"]), "set LIVING_PICTURE_PYTHON", True)
        else:
            add("python", "ok", "%s %s: numpy %s, scipy %s, Pillow %s" % (py, v["python"], v["numpy"], v["scipy"], v["Pillow"]),
                required=True, interpreter=py, chosen_by=why)

    # capture.mjs: Node 22+ (built-in WebSocket) and a Chromium-family browser
    node = find_node()
    via = "LIVING_PICTURE_NODE=" if os.environ.get("LIVING_PICTURE_NODE") else ""
    if not node:
        add("node", "missing", "node not found", "brew install node (22 or newer), or set LIVING_PICTURE_NODE", True)
    else:
        code, out, err = probe([node, "--version"])
        m = re.match(r"v(\d+)", out)
        if not m:  # it does not run at all: a wrong path or a broken install, not an old Node
            add("node", "missing", "%s%s does not run: %s" % (via, node, err or out or "exit %d" % code),
                "fix LIVING_PICTURE_NODE or unset it" if via else "reinstall Node 22+ (brew install node)", True)
        elif int(m.group(1)) >= 22:
            add("node", "ok", "%s %s" % (node, out), required=True)
        else:
            add("node", "old", "%s%s %s: capture needs Node 22+" % (via, node, out),
                "point LIVING_PICTURE_NODE at Node 22+" if via else "brew upgrade node", True)
    # capture.mjs takes the first that exists of --chrome, CHROME_PATH and its own list, so a wrong CHROME_PATH is
    # skipped there, not fatal
    chrome = os.environ.get("CHROME_PATH")
    if chrome and not os.path.exists(chrome):
        add("CHROME_PATH", "warn", "CHROME_PATH=%s does not exist; capture skips it and looks in the usual places" % chrome,
            "fix CHROME_PATH or unset it")
    found = next((p for p in ([chrome] if chrome else []) + browser_candidates() if os.path.exists(p)), None)
    if found:
        add("browser", "ok", found + (" (CHROME_PATH)" if found == chrome else ""), required=True)
    else:
        add("browser", "missing", "no Chrome, Chromium or Edge where capture.mjs looks", "install Google Chrome, or set CHROME_PATH", True)

    # video and the Apple helpers
    swift_ok = False
    if sys.platform == "darwin":
        code, devdir, _ = probe(["xcode-select", "-p"])
        if code != 0:  # checked first: a bare xcrun can pop up the installer dialog
            add("swiftc", "missing", "no Xcode or Command Line Tools: the Apple helpers are skipped", "xcode-select --install")
        else:
            code, _, _ = probe(["xcrun", "--find", "swiftc"])
            if code == 0:
                _, o, e = probe(["xcrun", "swiftc", "--version"], timeout=90)
                m = re.search(r"Swift version ([\w.\-]+)", o + " " + e)
                add("swiftc", "ok", "Swift %s (%s)" % (m.group(1) if m else "?", devdir))
                swift_ok = True
            else:
                add("swiftc", "missing", "xcrun finds no swiftc in %s" % devdir, "xcode-select --install")
    else:
        add("swiftc", "info", "not macOS: the Apple helpers are skipped; the other tools work")
    helpers = sorted(glob.glob(os.path.join(SCRIPTS, "macos", "*.swift")))
    if helpers:
        states = []
        for h in helpers:
            stem = os.path.splitext(os.path.basename(h))[0]
            binary = os.path.join(CACHE, "%s-%s" % (stem, sha256(h, 12)))
            states.append("%s (%s)" % (stem, "compiled" if os.access(binary, os.X_OK) else
                                       "compiles on first use" if swift_ok else "needs Xcode tools"))
        add("apple helpers", "info", ", ".join(states), cache=CACHE)
    else:
        add("apple helpers", "info", "none in this copy of the skill")
    ff = which("ffmpeg")
    avf = os.path.exists(os.path.join(SCRIPTS, "macos", "lpencode.swift"))
    if ff:
        _, out, _ = probe([ff, "-version"])
        m = re.search(r"ffmpeg version (\S+)", out)
        add("ffmpeg", "ok", "ffmpeg %s (%s)" % (m.group(1) if m else "?", ff))
    elif avf and swift_ok:
        add("ffmpeg", "info", "ffmpeg not found; video can use the AVFoundation encoder (lpencode)")
    else:
        add("ffmpeg", "missing", "ffmpeg not found: capture --video cannot encode", "brew install ffmpeg" + (" or xcode-select --install" if avf else ""))
    if sys.platform == "darwin":
        add("macos tools", "info", ", ".join("%s %s" % (t, "yes" if os.path.exists("/usr/bin/" + t) else "no")
                                             for t in ("sips", "avconvert", "qlmanage", "shortcuts")))

    # Codex (only for the opt-in bridges)
    codex = find_codex()
    if codex:
        ver = codex_version(codex)
        add("codex", "ok" if ver else "info", "%s (%s)%s" % (ver or "version unknown", codex, "" if which("codex") else ", not on PATH"))
    else:
        add("codex", "info", "Codex CLI not found (optional: only the opt-in bridges use it)")

    # where the skill is installed
    claude_home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(HOME, ".claude")
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(HOME, ".codex")
    linked = {}
    for area, path, home in (("install claude", os.path.join(claude_home, "skills", NAME), claude_home),
                             ("install agents", os.path.join(HOME, ".agents", "skills", NAME), os.path.join(HOME, ".agents")),
                             ("install codex", os.path.join(codex_home, "skills", NAME), codex_home),
                             ("install cli", os.path.join(HOME, ".local", "bin", NAME), None)):
        state, extra = install_state(path)
        good = state in ("this folder", "symlink to this folder", "symlink to this command")
        linked[area] = state if good else None
        detail = "%s: %s" % (tilde(path), state)
        if extra.get("target"):
            detail += " (%s)" % tilde(extra["target"])
        if state == "separate copy":
            detail += "; SKILL.md %s this folder's" % ("matches" if extra["same_skill_md"] else "differs from")
        fix = None
        if state == "missing" and area == "install codex":
            # current Codex reads ~/.agents/skills; this folder only matters to an older release
            detail += " (optional: Codex reads ~/.agents/skills)"
            fix = "only for a Codex that does not read ~/.agents/skills: scripts/install.sh --only codex"
        elif state == "missing":
            fix = "scripts/install.sh%s" % (" --with-cli" if area == "install cli" else "") + \
                  ("" if home is None or os.path.isdir(home) else " (the agent's folder %s does not exist yet)" % tilde(home))
        elif not good:
            fix = "left alone by scripts/install.sh; remove or rename it yourself if this folder should be used"
        add(area, "ok" if good else "info", detail, fix, path=path, state=state, **extra)
    if linked["install agents"] and linked["install codex"]:
        # Codex reads both folders and its docs say same-name skills are not merged
        extra_link = "codex" if linked["install codex"].startswith("symlink") else "agents"
        add("install twice", "warn", "both ~/.agents/skills and %s/skills lead to this folder: Codex reads both and may list "
            "living-picture twice" % tilde(codex_home), "keep one: scripts/install.sh --uninstall --only %s --apply" % extra_link)
    on_path = which(NAME)
    add("cli on PATH", "ok" if on_path and os.path.realpath(on_path) == os.path.realpath(__file__) else "info",
        "%s%s" % (on_path or "living-picture is not on PATH",
                  "" if not on_path or os.path.realpath(on_path) == os.path.realpath(__file__) else " (a different copy)"),
        None if on_path else "scripts/install.sh --with-cli, and ~/.local/bin on PATH")

    failed = [c["area"] for c in checks if c.get("required") and c["status"] != "ok"]
    as_json = a.json or (not a.text and not sys.stdout.isatty())
    if as_json:
        print(json.dumps({"skill": ROOT, "ok": not failed, "missing_required": failed, "checks": checks}, ensure_ascii=False, indent=1))
    else:
        print("living-picture doctor: %s" % tilde(ROOT))
        for c in checks:
            print("  %-7s %-14s %s" % (c["status"], c["area"], c["detail"] if c["area"].startswith("install") or c["area"] == "cli on PATH"
                                      else c["detail"].replace(HOME + os.sep, "~" + os.sep)))
            if c.get("fix") and c["status"] != "ok":
                print("  %-7s %-14s -> %s" % ("", "", c["fix"]))
        print("Everything required is in place." if not failed else "Missing or too old: %s" % ", ".join(failed))
    return 1 if failed else 0


# ---- new -------------------------------------------------------------------------------

NOTES = """# 工作笔记：{stem}

<!-- 边做边记：看到了什么、定了什么、为什么。坐标都指 work/picture.png。标题按 SKILL.md 的规则与交接清单。 -->

## 原图身份
- 原图：{source}
- sha256：{sha}
- 大小：{bytes} 字节{source_size}
- 建立：living-picture new，{date}

## 工作尺寸
- work/picture.png：{w}×{h} px（{made}）

## 画意
<!-- 一句话（规则 1）。 -->

## 读画
<!-- 材料；光与空气；支撑和遮挡；前后关系；保护区域；笔触画的是物体还是它的状态。 -->

## 动态主导与幅度
<!-- 选了什么、为什么最能传达画意；目标显示尺寸；因画意而小的依据（与缩幅遮错分开）。 -->

## 因果与节奏
<!-- 原因、承载者、响应、后果与恢复；每个原因的传递链；静的时候还剩什么；指针或触摸算“有人经过”；没有指针时（手机）怎么活。 -->

## 关系
<!-- 附着、支撑、接触、柔性连接、反射；哪些随承载者动，哪些相对动。 -->

## 资产处理
<!-- 分层与选区方法、补底方式、每轮 work/review/ 的发现。 -->

## 动态与镜头参数
<!-- scene.json 要点：深度、风、光、镜头、通道、hooks。 -->

## 工具版本
- 技能：{skill}（scripts 与 runtime 指纹 {fingerprint}）
<!-- 用到的可选工具（vision、视频编码等）。 -->

## 验证范围
<!-- 做了哪些检查、在什么尺寸、证据路径（check/…）。 -->

## 未决
<!-- 没做好的和未审的（例如只看了帧条，节奏未审）。 -->

## 规则 8 取舍
<!-- 仅在真冲突时：试过的替代、哪一项承载画意、公开让了什么。 -->

## 交付说明
<!-- 告诉使用者：让什么活了、为什么；什么故意留着不动；哪里没做好。 -->
"""


def git_root(path):
    for start in {os.path.abspath(path), os.path.realpath(path)}:
        p = start
        while True:
            if os.path.exists(os.path.join(p, ".git")):
                return p
            parent = os.path.dirname(p)
            if parent == p:
                break
            p = parent
    return None


def skill_fingerprint():
    h = hashlib.sha256()
    files = sorted(glob.glob(os.path.join(SCRIPTS, "**", "*.*"), recursive=True) +
                   glob.glob(os.path.join(ROOT, "runtime", "src", "*.js")))
    for f in files:
        if f.endswith((".py", ".mjs", ".js", ".swift")) and "__pycache__" not in f:
            h.update(os.path.relpath(f, ROOT).encode())
            h.update(sha256(f).encode())
    return h.hexdigest()[:12]


def run_tool(cmd):
    """Run a picture.py command, let its log through, return its JSON."""
    p = subprocess.run(cmd, stdout=subprocess.PIPE, text=True, env=ENV)
    if p.returncode:
        sys.stdout.write(p.stdout)
        die("%s failed (exit %d)" % (" ".join(cmd[2:4]), p.returncode), p.returncode)
    return json.loads(p.stdout.strip().splitlines()[-1])


def last_json(text):
    """The JSON object on the last line of a tool's stdout, or {}."""
    try:
        o = json.loads((text or "").strip().splitlines()[-1])
    except (ValueError, IndexError):
        return {}
    return o if isinstance(o, dict) else {}


def write_text(path, text):
    """Replace a file in one step, so an interrupted write never leaves half a notes.md."""
    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def add_to_section(text, heading, line):
    """text with `line` added at the end of its '## heading' section (at the end of the text if it has none)."""
    m = re.search(r"^## %s[ \t]*\n" % re.escape(heading), text, re.M)
    if not m:
        return text.rstrip("\n") + "\n\n" + line
    nxt = re.search(r"^## ", text[m.end():], re.M)
    end = m.end() + nxt.start() if nxt else len(text)
    body = text[m.end():end].rstrip("\n")
    return text[:m.end()] + (body + "\n" if body else "") + line + ("\n" if nxt else "") + text[end:]


# Written first, before anything is prepared: creating notes.md exclusively is the job folder's claim, so a second
# run into the same folder (Hero/ and hero/ are one folder on a Mac) is refused instead of mixing two pictures.
PENDING = "living-picture new 正在准备这个工作目录"
NOTES_PENDING = """# 工作笔记：{stem}

<!-- {mark}（{date}）。如果它停在这里没有完成：确认没有别的运行在用这个目录，删掉本文件再运行一次。 -->

## 原图身份
- 原图：{source}
- sha256：{sha}
"""


def png_size(path):
    """[width, height] from a PNG header, or None."""
    try:
        with open(path, "rb") as f:
            head = f.read(24)
    except OSError:
        return None
    if len(head) == 24 and head[:8] == b"\x89PNG\r\n\x1a\n" and head[12:16] == b"IHDR":
        return list(struct.unpack(">II", head[16:24]))
    return None


def job_state(job):
    """What a folder holds of a job (its notes.md identity lines, the working size), or None if it holds none."""
    notes, pic = os.path.join(job, "notes.md"), os.path.join(job, "work", "picture.png")
    held = [n for n, p in (("notes.md", notes), ("work/picture.png", pic)) if os.path.exists(p)]
    if not held:
        return None
    try:
        with open(notes, encoding="utf-8") as f:
            text = f.read()
    except (OSError, ValueError):
        text = ""
    source = re.search(r"^- 原图：(.+)$", text, re.M)
    sha = re.search(r"^- sha256：([0-9a-f]{64})\s*$", text, re.M)
    size = png_size(pic)
    if not size:  # the last size noted: a re-prepare made before anything referred to the grid may have changed it
        m = re.findall(r"^- work/picture\.png：(\d+)×(\d+) px", text, re.M)
        size = [int(m[-1][0]), int(m[-1][1])] if m else None
    made = FROM.findall(text)  # the last "工作图由 … 准备" that new or --reprepare wrote
    rec = RECT_FROM.findall(text)  # the last record of what rectified.png was corrected from
    return {"held": held, "source": source.group(1).strip() if source else None, "sha256": sha.group(1) if sha else None,
            "pending": PENDING in text, "size": size, "prepared_from": made_from(made[-1]) if made else None,
            "rectified": (rec[-1][0], ORIGIN[rec[-1][1]]) if rec else None}


def held_message(job, st, sha):
    if st["pending"]:
        return ("another `living-picture new` is preparing %s, or one stopped there before finishing (notes.md is still "
                "its placeholder, for %s); if no run is working there, delete that notes.md and run again" % (job, st["source"]))
    where = "%s already holds a job (%s)" % (job, ", ".join(st["held"]))
    if not st["sha256"]:
        return where + " whose picture cannot be confirmed: its notes.md has no sha256 line"
    if st["sha256"] == sha:
        return where + " for this same picture (notes.md: 原图 %s, same sha256)" % st["source"]
    return where + " for another picture (notes.md: 原图 %s, sha256 %s…; this picture's is %s…)" % (
        st["source"], st["sha256"][:12], sha[:12])


def on_grid(job):
    """Files of a job that refer to work/picture.png's pixel grid."""
    return sorted(os.path.basename(p) for p in glob.glob(os.path.join(job, "*.json"))) + \
        [n for n in ("work/layers", "work/review", "work/vision", "out") if os.path.exists(os.path.join(job, n))]


def find_watermark(image, tmp):
    """Run picture.py dewatermark on the picture into tmp. Returns its report with "search" set to "removed"
    (clean.png and clean-review.jpg are then in tmp), "none found" (its exit 4) or "failed": a crash, an
    out-of-memory kill or an unreadable file is reported with the tool's last words, never taken for "none found"."""
    py, _ = tools_python()
    sys.stderr.write("living-picture new: looking for a share-platform watermark in the lower right "
                     "(--keep-watermark skips this) ...\n")
    sys.stderr.flush()
    p = subprocess.run([py, PICTURE, "dewatermark", image, "--out", os.path.join(tmp, "clean.png")],
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=ENV)
    rep = last_json(p.stdout)
    if p.returncode == 0 and rep.get("found") and os.path.isfile(os.path.join(tmp, "clean.png")):
        return dict(rep, search="removed")
    if p.returncode in (0, 4) and rep.get("found") is False:
        return {"search": "none found"}
    how = ("killed by signal %d%s" % (-p.returncode, " (out of memory?)" if p.returncode == -9 else "")
           if p.returncode < 0 else "exit %d" % p.returncode)
    said = [ln.strip()[:300] for ln in ("%s\n%s" % (rep.get("error") or "", p.stderr or "")).splitlines() if ln.strip()]
    return {"search": "failed", "detail": "picture.py dewatermark: %s%s" % (how, ": " + " | ".join(said[-3:]) if said else "")}


def correct_photo(src, tmp, max_side):
    """Run picture.py rectify on src (the picture, or its watermark repair) into tmp. Returns its report with "run" set
    to "corrected" (rectified.png and rectified-review.jpg are then in tmp), "nothing to correct" (its exit 4: a flat
    scan or screenshot, or no artwork boundary found with confidence) or "failed": a crash, an out-of-memory kill or an
    unreadable file is reported with the tool's last words, never taken for "nothing to correct"."""
    py, _ = tools_python()
    sys.stderr.write("living-picture new: looking for a photographed artwork to crop, straighten and even out "
                     "(--as-is skips this) ...\n")
    sys.stderr.flush()
    out, sheet = os.path.join(tmp, RECT), os.path.join(tmp, RECT_REVIEW)
    p = subprocess.run([py, PICTURE, "rectify", src, "--out", out, "--review", sheet, "--max", str(max_side)],
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=ENV)
    rep = last_json(p.stdout)
    if p.returncode == 0 and rep.get("changed") and os.path.isfile(out):
        return dict(rep, run="corrected")
    for f in (out, sheet):             # exit 4 writes nothing; a run that failed may have left part of a file
        if os.path.exists(f):
            os.remove(f)
    if p.returncode == 4 and rep.get("changed") is False:
        return dict(rep, run="nothing to correct")
    how = ("killed by signal %d%s" % (-p.returncode, " (out of memory?)" if p.returncode == -9 else "")
           if p.returncode < 0 else "exit %d" % p.returncode)
    said = [ln.strip()[:300] for ln in ("%s\n%s" % (rep.get("error") or "", p.stderr or "")).splitlines() if ln.strip()]
    return {"run": "failed", "detail": "picture.py rectify: %s%s" % (how, ": " + " | ".join(said[-3:]) if said else "")}


def prepare_into(job, image, max_side, source=None, search=False, rectify_max=None):
    """prepare + look into a fresh hidden folder inside the job, so nothing in place changes unless all succeed.
    It prepares `source` (default: the picture). With `search` it then looks for a share-platform watermark on the
    picture, if the picture is no larger than platforms deliver; with `rectify_max` it then runs the photo correction
    (picture.py rectify, its output capped at that longer side) on the repaired copy or the picture. When either step
    wrote a copy, it prepares again from the last one. Returns (tmp, prepare report, look report, watermark report or
    None, rectify report or None, the picture's own [width, height])."""
    tmp = tempfile.mkdtemp(prefix=".living-picture-new-", dir=job)
    try:
        py, _ = tools_python()

        def prepare(src):
            return run_tool([py, PICTURE, "prepare", src, "--out", os.path.join(tmp, "work")] +
                            (["--max", str(max_side)] if max_side else []))
        first = src = source or image
        prep = prepare(first)
        # prepare reads every format the tools read, so its scale gives the picture's own size before the search
        own = [int(round(v / (prep.get("scale_from_source") or 1))) for v in prep["size"]]
        wm = rf = None
        if search:
            side = max(own)
            if side > WATERMARK_MAX_SIDE:
                wm = {"search": "skipped", "side": side,
                      "detail": "the picture is %d px on its longer side; share platforms deliver smaller pictures, so "
                                "only pictures up to %d px are searched (the search runs at full resolution)"
                                % (side, WATERMARK_MAX_SIDE)}
            else:
                wm = find_watermark(image, tmp)
                if wm["search"] == "removed":
                    src = os.path.join(tmp, "clean.png")
        if rectify_max:
            # after the watermark step: a platform's mark belongs to the posted image's corner, not to the work
            rf = correct_photo(src, tmp, rectify_max)
            if rf["run"] == "corrected":
                src = os.path.join(tmp, RECT)
        if src != first:
            prep = prepare(src)
        look = run_tool([py, PICTURE, "look", prep["picture"], "--out", os.path.join(tmp, "look.jpg")])
        return tmp, prep, look, wm, rf, own
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise


def move_in(tmp, job):
    """Put what prepare_into made in its place: same file system, so each file is swapped in one step."""
    work = os.path.join(job, "work")
    os.makedirs(work, exist_ok=True)
    for n in os.listdir(os.path.join(tmp, "work")):
        os.replace(os.path.join(tmp, "work", n), os.path.join(work, n))
    os.replace(os.path.join(tmp, "look.jpg"), os.path.join(job, "look.jpg"))
    # present only when a platform watermark was removed, or the photo corrected
    for n in ("clean.png", "clean-review.jpg", RECT, RECT_REVIEW):
        if os.path.exists(os.path.join(tmp, n)):
            os.replace(os.path.join(tmp, n), os.path.join(job, n))


# What notes.md records about the working copy's source; `--reprepare` reads the last one back.
FROM = re.compile(r"工作图由(原图| ?clean\.png ?| ?rectified\.png ?)准备")
# What rectified.png was corrected from, with the start of its sha256: --reprepare trusts the record only while the
# file is still that one (a copy redone by hand has none).
RECT_FROM = re.compile(r"rectified\.png（sha256 ([0-9a-f]{12})…，(由原图校正|由 clean\.png 校正|来源未记录)）")
ORIGIN = {"由原图校正": "picture", "由 clean.png 校正": "clean.png", "来源未记录": None}
BY_HAND_RECT = ("若这其实是一张画的照片：rectify 原图（去过水印时用 clean.png）--out rectified.png --corners \"x,y;x,y;x,y;x,y\"，"
                "核对 rectified-review.jpg，再 new --reprepare。")


def made_from(phrase):
    return RECT if "rectified" in phrase else "clean.png" if "clean" in phrase else "picture"


def from_phrase(name):
    """notes.md's "工作图由 … 准备" for a source: "picture", "clean.png" or "rectified.png"."""
    return "工作图由原图准备" if name == "picture" else "工作图由 %s 准备" % name


def rect_record(sha12, origin):
    return "rectified.png（sha256 %s…，%s）" % (sha12, {v: k for k, v in ORIGIN.items()}[origin])


def size_note(name, s):
    """notes.md's 工作尺寸 detail: what work/picture.png was prepared from and at what scale."""
    return ("由 rectified.png 准备，相对它缩放 %s" if name == RECT else "相对原图缩放 %s") % round(s, 4)


def by_hand_watermark(corrected):
    return ("若右下角其实有平台水印：dewatermark 原图 --out clean.png（找不到时加 --pill/--line 粗框），核对 clean-review.jpg，"
            "%s再 new --reprepare。" % ("再 rectify clean.png --out rectified.png 并核对 rectified-review.jpg（照片校正要基于"
                                       "修复后的图），" if corrected else ""))


def watermark_note(wm, corrected=False):
    """The 资产处理 line of a new job about the watermark step (the photo-correction line after it ends with what
    work/picture.png was prepared from)."""
    s = wm["search"]
    if s == "removed":
        p = wm.get("pill") or {}
        how = {"untint": "反推还原", "fill": "按周围颜料重画", "hybrid": "混合"}.get(p.get("mode"), p.get("mode"))
        return ("- 平台水印：living-picture new 已自动去除（picture.py dewatermark，标志框 %s，%s；ID 行 %s），修复后的图是 "
                "clean.png；原件未改；对比图 clean-review.jpg 需在显示尺寸和 4 倍下核对。\n"
                % (p.get("rect"), how, (wm.get("line") or {}).get("rect")))
    if s == "kept":
        return "- 平台水印：未查找（--keep-watermark）。\n"
    if s == "none found":
        return "- 平台水印：living-picture new 在右下角没有找到（picture.py dewatermark）。\n"
    if s == "skipped":
        return ("- 平台水印：未查找：原图长边 %d px，大于平台下载图（%d px 以内才自动查找，全尺寸查找很慢）。%s\n"
                % (wm["side"], WATERMARK_MAX_SIDE, by_hand_watermark(corrected)))
    return "- 平台水印：查找失败（%s）。%s\n" % (wm["detail"], by_hand_watermark(corrected))


FOCAL = {"exif": "焦距取自 EXIF", "vanishing points": "焦距由消失点推得", None: "按对边长度"}
REFERENCE = {"margin": "纸边或卡纸", "surround": "画外的墙面或桌面"}


def corrections(rf):
    """What rectify changed, as (English keys for the JSON, Chinese phrases for notes.md), and what it left as
    photographed and why (Chinese)."""
    did, zh, left = [], [], []
    pct = lambda v: "?" if v is None else "%d%%" % round(100 * v)  # noqa: E731
    if (rf.get("frame") or {}).get("removed"):
        did.append("frame or mat removed")
        zh.append("去掉画框或卡纸")
    pe = rf.get("perspective") or {}
    if pe.get("applied"):
        f = pe.get("focal")
        did.append("cropped and perspective corrected")
        zh.append("裁出画并校正透视（倾斜约 %s°，宽高比 %s，%s）" % (
            pe.get("tilt_deg"), pe.get("aspect"),
            "假定手机主摄（%s）" % f.replace("assumed ", "") if str(f).startswith("assumed") else FOCAL.get(f, f)))
    le = rf.get("lens") or {}
    if le.get("applied"):
        did.append("lens distortion")
        zh.append("镜头畸变（k1 %s）" % le.get("k1"))
    li = rf.get("light") or {}
    if li.get("applied"):
        did.append("light evened out")
        zh.append("按%s匀平光照（不均 %s → %s）" % (REFERENCE.get(li.get("reference"), li.get("reference")),
                                             pct(li.get("variation_before")), pct(li.get("variation_after"))))
    elif li.get("why"):
        left.append("光照（%s）" % li["why"])
    co = rf.get("color") or {}
    if co.get("applied"):
        did.append("colour cast removed")
        zh.append("按%s去掉色偏（增益 r/g/b %s）" % (REFERENCE.get(co.get("reference"), co.get("reference")),
                                              "/".join("%.2f" % g for g in co.get("gains") or [])))
    elif co.get("why"):
        left.append("颜色（%s）" % co["why"])
    if rf.get("exposure"):
        did.append("exposure")
        zh.append("曝光 ×%.2f" % rf["exposure"])
    return did, zh, left


def rectify_note(rf, rect_in, sha12=None):
    """The 资产处理 lines of a new job about the photo correction, ending with what work/picture.png was prepared
    from. rect_in is what rectify ran on: "picture" or "clean.png"."""
    r = rf["run"]
    end = from_phrase(RECT if r == "corrected" else rect_in) + "。"
    warns = ["  - 警告：%s" % w for w in rf.get("warnings") or []]
    if r == "skipped":
        return "- 照片校正：未运行（--as-is）。%s\n" % end
    if r == "failed":
        return "- 照片校正：picture.py rectify 失败（%s）。%s%s\n" % (rf["detail"], end, BY_HAND_RECT)
    if r == "nothing to correct":
        return "\n".join(["- 照片校正：picture.py rectify 没有改动（%s）。%s%s" % (
            rf.get("note") or "exit 4", end, BY_HAND_RECT if warns else "")] + warns) + "\n"
    src = "原图" if rect_in == "picture" else "clean.png"
    qd, fr = rf.get("quad") or {}, rf.get("frame") or {}
    _, zh, left = corrections(rf)
    lines = ["- 照片校正：living-picture new 用 picture.py rectify 校正了%s（原件未改），得到 %s，%s px。" % (
                 src, rect_record(sha12, rect_in), "×".join(str(v) for v in rf.get("size_out") or ["?", "?"])),
             "  - 边界：四角 %s（%s的像素，左上、右上、右下、左下；来源 %s，置信 %s）%s。" % (
                 json.dumps(qd.get("corners")), src, qd.get("source"), qd.get("confidence"),
                 "；找到画框或卡纸并去掉" if fr.get("removed") else "；找到画框或卡纸，保留" if fr.get("found") else ""),
             "  - 改了：%s。" % ("；".join(zh) or "无")]
    if left:
        lines.append("  - 没改：%s。" % "；".join(left))
    lines += warns
    lines.append("  - 对比图 rectified-review.jpg（照片与找到的边界｜校正结果｜光和颜色改在哪里、改了多少）需在显示尺寸和放大后核对；"
                 "边界不对时用 rectify --corners 重做到 rectified.png，再 new --reprepare（不用校正：--reprepare --as-is）。%s"
                 % end)
    return "\n".join(lines) + "\n"


def set_aside(job, stem):
    """Rename <stem>.png and <stem>-review.jpg (stem: clean or rectified) to <stem>-unused[-N]…, so the job no longer
    reads as prepared from a copy it does not use, and a hand-made copy is not lost. Returns [(old name, new name)]."""
    n = 1
    while True:
        tag = stem + "-unused" + ("" if n == 1 else "-%d" % n)
        pairs = [(stem + ".png", tag + ".png"), (stem + "-review.jpg", tag + "-review.jpg")]
        if not any(os.path.exists(os.path.join(job, b)) for _, b in pairs):
            break
        n += 1
    done = []
    for a, b in pairs:
        if os.path.exists(os.path.join(job, a)):
            os.replace(os.path.join(job, a), os.path.join(job, b))
            done.append((a, b))
    return done


def watermark_summary(wm, job):
    """The watermark step for new's JSON."""
    out = {"search": wm["search"]}
    if wm["search"] == "removed":
        out.update({"pill": (wm.get("pill") or {}).get("rect"), "mode": (wm.get("pill") or {}).get("mode"),
                    "line": (wm.get("line") or {}).get("rect"), "clean": os.path.join(job, "clean.png"),
                    "review": os.path.join(job, "clean-review.jpg")})
    elif wm.get("detail"):
        out["detail"] = wm["detail"]
    return out


def rectify_summary(rf, job, rect_in):
    """The photo-correction step for new's JSON: rectify's own report with the job's paths, without its timing."""
    out = {"run": rf["run"]}
    if rf["run"] == "skipped":
        out["detail"] = "--as-is: the picture is used as received (after the watermark step)"
    elif rf["run"] == "failed":
        out["detail"] = rf["detail"]
    else:
        out["input"] = rect_in
        keys = ("note", "warnings", "size_in", "alternatives")      # exit 4: why, and the candidates for --corners
        if rf["run"] == "corrected":
            out.update(rectified=os.path.join(job, RECT), review=os.path.join(job, RECT_REVIEW),
                       corrected=corrections(rf)[0])
            keys = ("note", "warnings", "size_in", "size_out", "quad", "frame", "lens", "perspective", "light", "color",
                    "exposure", "alternatives")
        out.update((k, rf[k]) for k in keys if k in rf)
    return out


def cmd_new(argv):
    ap = argparse.ArgumentParser(prog="living-picture new",
                                 description="Start a job folder for one picture: remove a share-platform watermark if one is "
                                             "found (pictures up to %d px on the longer side are searched), correct a casual photo "
                                             "of the work (picture.py rectify: crop it from the wall, frame, mat or table round it, "
                                             "undo perspective and lens bending, even out uneven light and a colour cast against "
                                             "neutral paper, mat or wall; a flat scan or screenshot passes through unchanged), "
                                             "prepare the working copy (work/picture.png) from the result, draw the grid view "
                                             "(look.jpg) and write a notes.md skeleton with the headings SKILL.md asks for, beginning "
                                             "with the picture's path and sha256. The picture itself is never changed. It claims the "
                                             "folder before preparing anything and never changes a folder that already holds a job "
                                             "(only --reprepare, for the same picture). The job folder must stay out of git "
                                             "repositories and published folders (SKILL.md), so it refuses those unless --force."
                                             % WATERMARK_MAX_SIDE)
    ap.add_argument("image", help="the picture")
    ap.add_argument("--job", help="job folder (default: ./<picture name>)")
    ap.add_argument("--max", type=int, help="cap for the working copy's longer side (prepare --max; default 1600, "
                                            "or the job's own size with --reprepare); the photo correction keeps up to "
                                            "%d px, or this if larger" % RECTIFY_MAX)
    ap.add_argument("--force", action="store_true",
                    help="allow a job folder inside a git repository or inside the skill folder; it never overrides an existing job")
    ap.add_argument("--reprepare", action="store_true",
                    help="redo work/picture.png and look.jpg of an existing job, for example after the tools changed or after "
                         "redoing rectified.png or clean.png by hand: only for the picture its notes.md names (same sha256), and "
                         "only at the job's own working size once plan.json, scene.json, layers or vision output refer to that "
                         "pixel grid (before that a new size is taken and reported). It prepares from the job's rectified.png "
                         "when there is one (the photo correction, automatic or by hand), else its clean.png (the watermark "
                         "repair), else the picture; it never runs dewatermark or rectify itself, refuses instead of silently "
                         "switching when a copy notes.md names is gone, and adds a line to notes.md")
    ap.add_argument("--keep-watermark", action="store_true",
                    help="do not look for a share-platform watermark (by default new looks in the lower right for a logo pill "
                         "with an ID line under it, removes it with picture.py dewatermark into clean.png and continues from "
                         "that). With --reprepare: leave the job's clean.png out (it is renamed clean-unused.png)")
    ap.add_argument("--as-is", action="store_true",
                    help="do not correct the picture as a photo (by default new runs picture.py rectify, which finds the "
                         "artwork in a casual photo, crops it, undoes perspective and lens bending and evens out light and "
                         "colour against a neutral margin, mat or wall, into rectified.png with the review sheet "
                         "rectified-review.jpg; it leaves a flat scan or screenshot alone). With --reprepare: prepare without "
                         "the job's rectified.png, which is renamed rectified-unused.png")
    a = ap.parse_args(argv)
    image = os.path.abspath(os.path.expanduser(a.image))
    if not os.path.isfile(image):
        die("no such picture: %s" % image)
    stem = re.sub(r"\s+", "-", os.path.splitext(os.path.basename(image))[0]).strip("-") or "picture"
    job = os.path.abspath(os.path.expanduser(a.job or stem))
    if os.path.exists(job) and not os.path.isdir(job):
        die("%s exists and is not a folder" % job)
    problems = []
    repo = git_root(job)
    if repo:
        problems.append("%s is inside the git repository %s (SKILL.md keeps the picture and everything cut from it out of "
                        "version control unless the person agrees)" % (job, repo))
    if inside(job, ROOT):
        problems.append("%s is inside the skill folder" % job)
    if problems and not a.force:
        die("; ".join(problems) + ". Choose another --job, or pass --force if this is intended.")
    sha = sha256(image)
    st = job_state(job)
    if st and not a.reprepare:
        if st["pending"]:
            die(held_message(job, st, sha) + ". Nothing was changed.")
        die(held_message(job, st, sha) + ". Nothing was changed. Continue that job%s, or choose another --job." % (
            " (or redo its working copy with --reprepare)" if st["sha256"] == sha else " only if it is yours"))
    if a.reprepare and not st:
        die("%s holds no job to re-prepare (no notes.md or work/picture.png); drop --reprepare to start one" % job)
    if a.reprepare and (st["pending"] or st["sha256"] != sha):
        die(held_message(job, st, sha) + ". --reprepare only redoes the working copy of a job for this same picture.")
    warnings = []
    for d in (os.path.join(HOME, "Library", "Mobile Documents"), os.path.join(HOME, "Library", "CloudStorage")):
        if inside(job, d):
            warnings.append("the job folder is inside %s: a sync service will upload what is written there" % tilde(d))
    for d in (os.path.join(HOME, "Desktop"), os.path.join(HOME, "Documents")):
        if inside(job, d):
            warnings.append("the job folder is inside %s: if iCloud 'Desktop & Documents Folders' is on, it is uploaded to iCloud" % tilde(d))
    lp = os.path.join(ROOT, "bin", NAME)
    pic, look_jpg, notes = os.path.join(job, "work", "picture.png"), os.path.join(job, "look.jpg"), os.path.join(job, "notes.md")
    clean, review = os.path.join(job, "clean.png"), os.path.join(job, "clean-review.jpg")
    rect, rect_review = os.path.join(job, RECT), os.path.join(job, RECT_REVIEW)

    if a.reprepare:
        # The copies to use are the job's own rectified.png and clean.png, made by new or by hand with rectify and
        # dewatermark; running those again here would overwrite a hand-made copy and could undo a choice made on purpose.
        old = st["size"]
        has_clean, has_rect = os.path.isfile(clean), os.path.isfile(rect)
        prior, rec = st["prepared_from"], st["rectified"]
        if prior == RECT and not has_rect and not a.as_is:
            die("notes.md says work/picture.png was prepared from rectified.png (the photo corrected by rectify), but %s is "
                "gone. Nothing was changed. Make it again (%s rectify %s --out %s, then check %s) and run this again, or "
                "pass --as-is to prepare without the photo correction."
                % (rect, q(lp), q(clean if has_clean else image), q(rect), rect_review))
        use_rect = has_rect and not a.as_is
        # what rectified.png was corrected from: known only while it is the copy notes.md recorded (None: by hand)
        origin = rec[1] if use_rect and rec and rec[0] == sha256(rect, 12) else None
        redo = "%s rectify %%s --out %s, then check %s" % (q(lp), q(rect), rect_review)
        if use_rect and origin == "clean.png" and a.keep_watermark:
            die("rectified.png was corrected from clean.png (notes.md), so it carries the watermark repair that "
                "--keep-watermark leaves out. Nothing was changed. Redo it from the picture as received (%s) and run this "
                "again, or add --as-is to prepare from the picture as received without the photo correction."
                % (redo % q(image)))
        if use_rect and origin == "picture" and has_clean and not a.keep_watermark:
            die("the job has clean.png (a watermark repair), but rectified.png was corrected from the picture as received "
                "(notes.md), so the repair is not in it. Nothing was changed. Redo it from the repair (%s) and run this "
                "again; or pass --keep-watermark to set clean.png aside and keep this photo correction, or --as-is to "
                "prepare from clean.png without the photo correction." % (redo % q(clean)))
        used_clean = prior == "clean.png" or (prior == RECT and bool(rec) and rec[1] == "clean.png")
        if not use_rect and used_clean and not has_clean and not a.keep_watermark:
            die("notes.md says the working copy was made from clean.png (the picture with a share-platform watermark "
                "removed), but %s is gone. Nothing was changed. Make it again (%s dewatermark %s --out %s, then check %s) "
                "and run this again, or pass --keep-watermark to prepare from the picture as received, mark and all."
                % (clean, q(lp), q(image), q(clean), review))
        source = rect if use_rect else clean if has_clean and not a.keep_watermark else image
        name = RECT if source == rect else "clean.png" if source == clean else "picture"
        tmp, prep, look, _, _, _ = prepare_into(job, image, a.max or (max(old) if old else None),  # by default the job's own size
                                                source=source)
        try:
            new = list(prep["size"])
            resized = bool(old) and new != list(old)
            if resized and on_grid(job):  # a new size only while nothing refers to the old grid (right after new)
                die("re-preparing gives %d×%d px, but this job's working picture is %d×%d px, and %s refer to that pixel grid. "
                    "Nothing was changed. A different working size needs a new job folder."
                    % (new[0], new[1], old[0], old[1], ", ".join(on_grid(job))))
            changed = not (os.path.exists(pic) and filecmp.cmp(pic, prep["picture"], shallow=False))
            move_in(tmp, job)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        aside_c, aside_r = [], []
        try:  # also a review sheet left from a deleted copy
            aside_c = set_aside(job, "clean") if a.keep_watermark else []
            aside_r = set_aside(job, "rectified") if a.as_is else []
        except OSError as e:
            warnings.append("could not rename a copy that is no longer used out of the way (%s): the next --reprepare "
                            "would use it again; rename it yourself" % e)
        stale = [n for n in ("work/layers", "work/review", "out") if os.path.exists(os.path.join(job, n))]
        if changed and stale:
            warnings.append("work/picture.png changed at the same size: %s were made from the previous copy; re-run cut, "
                            "bundle and the checks" % ", ".join(stale))
        if resized:
            warnings.append("work/picture.png is now %d×%d px instead of %d×%d: nothing referred to the old pixel grid yet, "
                            "but coordinates noted before (notes.md) are in the old size" % (new[0], new[1], old[0], old[1]))
        date = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
        s = prep.get("scale_from_source") or 1
        what = {RECT: lambda: "%s；%s" % (rect_record(sha256(rect, 12), origin), from_phrase(RECT)),
                "clean.png": lambda: "%s（sha256 %s…）" % (from_phrase("clean.png"), sha256(clean, 12)),
                "picture": lambda: from_phrase("picture")}[name]()
        line = "- 重新准备（%s，living-picture new --reprepare%s）：%s；像素%s%s%s。\n" % (
            date, "".join(f for f, on in ((" --keep-watermark", a.keep_watermark), (" --as-is", a.as_is)) if on), what,
            "有变化" if changed else "未变", "；工作尺寸由 %d×%d 改为 %d×%d" % (old[0], old[1], new[0], new[1]) if resized else "",
            "；%s，不再使用" % "、".join("%s 改名为 %s" % p for p in aside_c + aside_r) if aside_c + aside_r else "")
        try:
            with open(notes, encoding="utf-8") as f:
                text = add_to_section(f.read(), "资产处理", line)
            if resized:
                text = add_to_section(text, "工作尺寸", "- work/picture.png：%d×%d px（%s 重新准备后；%s）\n" % (
                    new[0], new[1], date, size_note(name, s)))
            write_text(notes, text)
            added = line.strip()
        except (OSError, ValueError) as e:
            warnings.append("could not add the re-prepare to notes.md (%s): record it there yourself" % e)
            added = None
        # the watermark repair is in the working copy: directly, through rectified.png, or unknown (rectified.png by hand)
        wm_in = True if name == "clean.png" or origin == "clean.png" else \
            None if name == RECT and origin is None and has_clean and not a.keep_watermark else False
        print(json.dumps({"job": job, "picture": pic, "size": new, "scale_from_source": s, "look": look_jpg,
                          "grid_every": look.get("grid_every"), "notes": notes, "notes_written": False, "notes_added": added,
                          "reprepared": True, "changed": changed, "size_changed": [list(old), new] if resized else None,
                          "prepared_from": source, "watermark_removed": wm_in,
                          "watermark": {"search": "not run: --reprepare prepares from the job's own copies (rectified.png, "
                                                  "else clean.png, else the picture)", "set_aside": [b for _, b in aside_c]},
                          "photo_corrected": name == RECT,
                          "rectify": {"run": "not run: --reprepare uses the job's rectified.png when there is one",
                                      "corrected_from": ({"picture": image, "clean.png": clean}.get(origin) or
                                                         "not recorded (made by hand)") if name == RECT else None,
                                      "set_aside": [b for _, b in aside_r]},
                          "warnings": warnings,
                          "next": ["look at %s" % look_jpg] +
                                  (["check the photo correction: %s (the photo with the boundary found | the corrected "
                                    "picture | where light and colour changed) at display size and zoomed in" % rect_review]
                                   if name == RECT and os.path.exists(rect_review) else []) +
                                  (["check the watermark repair: %s (before | after | repaired) at display size and 4x" % review]
                                   if wm_in and os.path.exists(review) else []) +
                                  (["re-run cut, bundle and the checks: the working copy's pixels changed"]
                                   if changed and stale else []) +
                                  ["add to notes.md why it was re-prepared (a line was added under 资产处理)"]},
                         ensure_ascii=False))
        return 0

    created = not os.path.isdir(job)
    os.makedirs(job, exist_ok=True)
    try:
        fd = os.open(notes, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        st = job_state(job)
        die((held_message(job, st, sha) if st else "another run claimed %s a moment ago" % job) +
            ". Nothing was changed; choose another --job.")
    date = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(NOTES_PENDING.format(stem=stem, mark=PENDING, date=date, source=image, sha=sha))
    done = moved = False
    try:
        tmp, prep, look, wm, rf, own = prepare_into(job, image, a.max, search=not a.keep_watermark,
                                                    rectify_max=None if a.as_is else max(RECTIFY_MAX, a.max or 0))
        wm, rf = wm or {"search": "kept"}, rf or {"run": "skipped"}
        try:
            move_in(tmp, job)
            moved = True
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        w, h = prep["size"]
        s = prep.get("scale_from_source") or 1
        corrected = rf["run"] == "corrected"
        rect_in = "clean.png" if wm["search"] == "removed" else "picture"   # what rectify ran on
        name = RECT if corrected else rect_in                               # what work/picture.png was prepared from
        text = NOTES.format(stem=stem, source=image, sha=sha, bytes=os.path.getsize(image),
                            source_size="；原图约 %d×%d px" % (own[0], own[1]), date=date, w=w, h=h,
                            made=size_note(name, s), skill=ROOT, fingerprint=skill_fingerprint())
        text = add_to_section(text, "资产处理", watermark_note(wm, corrected))
        text = add_to_section(text, "资产处理", rectify_note(rf, rect_in, sha256(rect, 12) if corrected else None))
        with open(notes, "w", encoding="utf-8") as f:  # still the placeholder this run created above
            f.write(text)
        done = True
    finally:
        if not done:  # give the folder back: a failed run must not leave a half job that blocks the next one
            for p in ([pic, look_jpg, clean, review, rect, rect_review] if moved else []) + [notes]:
                try:
                    os.remove(p)
                except OSError:
                    pass
            if created:
                for d in (os.path.join(job, "work"), job):
                    try:
                        os.rmdir(d)  # only when empty
                    except OSError:
                        pass
    if wm["search"] == "failed":
        warnings.append("the watermark search failed, so the picture was prepared as received: %s" % wm["detail"])
    if rf["run"] == "failed":
        warnings.append("the photo correction failed, so %s was prepared as it is: %s"
                        % ("clean.png" if rect_in == "clean.png" else "the picture", rf["detail"]))
    warnings += ["photo correction: %s" % w_ for w_ in rf.get("warnings") or []]
    src_r = clean if rect_in == "clean.png" else image    # what rectify ran on, and what to redo it from
    reprep = "%s new %s --job %s --reprepare" % (q(lp), q(image), q(job))
    redo = ("%s rectify %s --out %s --corners \"x,y;x,y;x,y;x,y\" (the work's corners in that picture's pixels, top-left, "
            "top-right, bottom-right, bottom-left; %s look %s --out %s shows that picture with a grid)"
            % (q(lp), q(src_r), q(rect), q(lp), q(src_r), q(os.path.join(job, "photo-look.jpg"))))
    by_hand = ("if look.jpg shows a share-platform mark in the lower right: %s dewatermark %s --out %s (rough --pill/--line "
               "boxes if it is not found), check %s, %sthen %s"
               % (q(lp), q(image), q(clean), review,
                  "redo the photo correction from it (%s rectify %s --out %s, adding --corners if you gave them before) and "
                  "check %s, " % (q(lp), q(clean), q(rect), rect_review) if corrected else "", reprep))
    nxt = []
    if corrected:
        nxt += ["check the photo correction first: %s (the photo with the boundary found | the corrected picture | where "
                "light and colour changed) at display size and zoomed in: the boundary on the work's own edge all round, no "
                "frame, mat or wall left and nothing of the work cut off, straight lines straight, colours like the work's "
                "own rather than a white-balanced room%s" % (rect_review if os.path.exists(rect_review) else rect,
                                                             "; weigh the warnings" if rf.get("warnings") else ""),
                "if the boundary or a correction is wrong, redo it into the same file: %s, or take a candidate from "
                "rectify.alternatives, or use --frame keep|remove, --light off, --color off; check %s again, then %s (a new "
                "working size is taken until plan.json, layers or vision output exist). To work from %s without the "
                "correction: %s --as-is" % (redo, rect_review, reprep,
                                            "clean.png" if rect_in == "clean.png" else "the picture as received", reprep)]
    if wm["search"] == "removed":
        nxt.append("check the watermark repair: %s (before | after | repaired) at display size and 4x" % review)
    nxt.append("look at %s (and zoom with: %s look %s --box X0 Y0 X1 Y1)" % (look_jpg, q(lp), q(pic)))
    if wm["search"] in ("skipped", "failed"):
        nxt.append(by_hand)
    if rf["run"] in ("nothing to correct", "failed"):
        nxt.append("if look.jpg shows a photo of the work rather than the work alone (wall, frame, mat, table or hands round "
                   "it, or taken at an angle): %s, check %s, then %s" % (redo, rect_review, reprep))
    nxt += ["write the picture's intent and reading into notes.md (SKILL.md rules 1-2)",
            "write %s, then: %s cut %s" % (os.path.join(job, "plan.json"), q(lp), q(os.path.join(job, "plan.json")))]
    print(json.dumps({"job": job, "picture": pic, "size": [w, h], "scale_from_source": s,
                      "prepared_from": {RECT: rect, "clean.png": clean, "picture": image}[name], "look": look_jpg,
                      "grid_every": look.get("grid_every"), "notes": notes, "notes_written": True, "warnings": warnings,
                      "watermark_removed": wm["search"] == "removed", "watermark": watermark_summary(wm, job),
                      "photo_corrected": corrected, "rectify": rectify_summary(rf, job, src_r), "next": nxt},
                     ensure_ascii=False))
    return 0


def cmd_paths(argv):
    if argv and argv[0] in ("-h", "--help"):
        print("usage: living-picture paths\n\nPrint where the skill's files are, as JSON.")
        return 0
    j = lambda *p: os.path.join(ROOT, *p)  # noqa: E731
    print(json.dumps({"skill": ROOT, "skill_md": j("SKILL.md"), "references": j("references"),
                      "invocation": j("references", "invocation.md"), "cli": os.path.realpath(__file__),
                      "picture_py": PICTURE, "capture": CAPTURE, "codex_bridge": BRIDGE,
                      "install": j("scripts", "install.sh"), "workflow": j("workflows", "living-picture-batch.js"),
                      "example": j("examples", "night-house"), "helper_cache": CACHE}, ensure_ascii=False))
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(usage())
        return 0 if argv else 1
    cmd, rest = argv[0], argv[1:]
    if cmd == "help":
        if not rest:
            sys.stdout.write(usage())
            return 0
        cmd, rest = rest[0], ["--help"]
    if cmd not in OWN and cmd in [n for n, _ in picture_commands()]:
        exec_([tools_python()[0], PICTURE, cmd] + rest)
    if cmd == "capture":
        node = find_node()
        if not node:
            die("node not found: capture needs Node 22+ (brew install node), or set LIVING_PICTURE_NODE")
        exec_([node, CAPTURE] + rest)
    if cmd == "codex":
        exec_([sys.executable, BRIDGE] + rest)
    if cmd == "doctor":
        return cmd_doctor(rest)
    if cmd == "new":
        return cmd_new(rest)
    if cmd == "paths":
        return cmd_paths(rest)
    if cmd == "vision":
        die("this copy of picture.py has no vision command (the macOS Vision helper is not part of it)")
    die("unknown command %r (living-picture --help lists them)" % cmd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
